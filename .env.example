HOST=127.0.0.1
PORT=3000
NODE_ENV=development
NOMI_LAUNCH_MODE=setup

# Nomi application and provider configuration.
# These integrations are being prepared; the current API is still a foundation.
APP_URL=https://nomibrief.com
DATABASE_URL=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=oJCdZCYaJobw2GlrIQm5
